" Numbers are relative but the actual line is numbered correctly yipiiii
set number
set relativenumber

" Tabs are pretty with 4 spaces
filetype plugin indent on
set expandtab
set shiftwidth=4
set softtabstop=4
set tabstop=4
set smartindent

" Don't know if this do something
syntax on

" Quit the -- INSERT --
set noshowmode

" Hide the file info line (thx Claude)
set shortmess+=F

" To show popup suggestions (thx gemini)
set completeopt=menu,menuone,noinsert,popup

" highlights text when searching
set hlsearch
